.{
    .name = .rtype_poc_zig,
    .version = "0.1.0",
    .fingerprint = 0x7dfd4ff72f1f67e5, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // raylib-zig on its default branch, devel, pinned to one commit: it has
        // no release for raylib 6.0. It builds raylib 6.0 from source, with
        // raylib's own build.zig.
        .raylib_zig = .{
            .url = "git+https://github.com/raylib-zig/raylib-zig#8758f4cd3a5ae0df6941c4715257223d34c5ad3e",
            .hash = "raylib_zig-6.0.0-KE8RECZ8BQDm-txuospkpZHbJ6DNpacUF7D88RWQ_qAe",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "assets",
        "client",
        "engine",
        "game",
        "server",
        "tests",
    },
}
